
@bot.command(name="猜拳")
async def rps(ctx, user_choice: str):
    choices = ["石頭", "剪刀", "布"]
    if user_choice not in choices:
        await ctx.send("❌ 請輸入正確的拳型：`!猜拳 石頭`、`!猜拳 剪刀` 或 `!猜拳 布`")
        return
        
    bot_choice = random.choice(choices)
    
    # 判定輸贏邏輯
    if user_choice == bot_choice:
        result = "雙方打平！🤝"
    elif (user_choice == "石頭" and bot_choice == "剪刀") or \
         (user_choice == "剪刀" and bot_choice == "布") or \
         (user_choice == "布" and bot_choice == "石頭"):
        result = f"恭喜你贏了！🎉"
    else:
        result = "哈哈你輸了，再接再厲！😜"
        
    await ctx.send(f"🤖 機器人出了：**{bot_choice}**\n👤 {ctx.author.mention} 出了：**{user_choice}**\n📢 結果：{result}")
